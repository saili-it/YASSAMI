APP_NAME=YASSAMI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# « mysql » = nom du service Docker. Depuis l’hôte : DB_HOST=127.0.0.1 et DB_PORT=3310.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=yassami
DB_USERNAME=yassami
DB_PASSWORD=yassami

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# YASSAMI — paramètres métier (lus UNIQUEMENT via config/yassami.php)
# Ne jamais inventer ces valeurs : laisser vide tant que le client ne les a
# pas fournies. Les éléments vides sont masqués sur le site.
# ---------------------------------------------------------------------------
# Numéro WhatsApp de réception des commandes, format international sans « + »
# ni espaces (ex. 2126XXXXXXXX). Obligatoire pour commander.
# Valeurs initiales seulement : elles se gèrent dans /admin/parametres,
# et la valeur enregistrée dans l'admin remplace celle-ci.
YASSAMI_WHATSAPP_NUMBER=
YASSAMI_CONTACT_PHONE=
YASSAMI_CONTACT_EMAIL=
YASSAMI_CONTACT_ADDRESS=
YASSAMI_INSTAGRAM_URL=
YASSAMI_FACEBOOK_URL=
YASSAMI_TIKTOK_URL=
